generator client {
  provider      = "prisma-client-js"
  // GitHub Actions (debian) prebuilds for Vercel (rhel) — ship both engines.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Pymtx schema — Ontario B2C AR Settlement (Path B / Zero-Custody)
// Money never custodied by Pymtx: Business = creditor + Merchant of Record.
// Stripe Connect Direct Charges + ACSS Debit (Payments Canada Rule H1 PAD).
// =============================================================================

/// Platform-wide compliance + take-rate knobs (singleton row id = "platform").
model PlatformSettings {
  id                     String   @id @default("platform")
  /// Software fee in basis points on each Direct Charge (default 250 = 2.50%).
  applicationFeeBps      Int      @default(250)
  /// Rule H1-aligned skip notice: request ≥ N business days before debit.
  skipNoticeBusinessDays Int      @default(3)
  /// One skip privilege every N calendar days (product: 180).
  skipCooldownDays       Int      @default(180)
  /// Rule H1 NSF: max re-presentments after a failed debit.
  nsfRetryMax            Int      @default(1)
  /// Rule H1 NSF: re-presentment must occur within N days of original debit.
  nsfRetryWindowDays     Int      @default(30)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// SMB creditor. Remains Merchant of Record on Stripe Connect.
model Business {
  id                       String    @id @default(cuid())
  legalName                String
  tradeName                String
  email                    String    @unique
  phone                    String?
  /// Ontario corporation / business number (optional at signup).
  ontarioCorpNumber        String?
  province                 String    @default("ON")
  /// ACTIVE | SUSPENDED | CLOSED
  status                   String    @default("ACTIVE")

  /// Stripe Connect Express/Custom account — funds land here (Direct Charges).
  stripeAccountId          String?   @unique
  stripeOnboardingComplete Boolean   @default(false)
  stripeChargesEnabled     Boolean   @default(false)
  stripePayoutsEnabled     Boolean   @default(false)
  stripeDetailsSubmitted   Boolean   @default(false)
  stripeOnboardedAt        DateTime?

  /// CASL: business consents that invites are sent under its identity.
  caslConsentAt            DateTime?

  /// Merchant physical / mailing address (Ontario) for PAD + CASL disclosures.
  physicalAddress          String?
  /// Customer-facing support inbox (defaults to business email when null).
  supportEmail             String?

  /// Master SaaS Agreement & Merchant Indemnity acceptance audit.
  saasAgreementAcceptedAt  DateTime?
  saasAgreementVersion     String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  customers                Customer[]
  invoices                 Invoice[]
  transactionMetrics       TransactionMetric[]
  caslMessages             CaslMessage[]
  deferredNotices          DeferredNotice[]
  users                    User[]

  @@index([status])
  @@index([stripeAccountId])
}

/// Consumer debtor invited to settle a past-due invoice.
model Customer {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  firstName       String
  lastName        String
  email           String
  phone           String?
  /// Ontario billing / mailing address for PAD identification of parties.
  address         String?
  /// Opaque portal invite token (never guessable sequential ids).
  inviteToken     String    @unique @default(cuid())
  invitedAt       DateTime?
  activatedAt     DateTime?
  /// CDSSA / counsel kill-switch — halt automated debtor notices (not magic-link auth).
  communicationPausedAt     DateTime?
  communicationPauseReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices        Invoice[]
  paymentPlans    PaymentPlan[]
  caslMessages    CaslMessage[]
  sessions        Session[]
  magicLinks      MagicLink[]

  @@unique([businessId, email])
  @@index([inviteToken])
  @@index([businessId])
  @@index([email])
  @@index([communicationPausedAt])
}

/// Past-due receivable uploaded by the business (principal owed to Business).
model Invoice {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id])
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id])
  /// Business's own invoice / account number.
  externalRef         String
  description         String
  originalAmountCents Int
  balanceCents        Int
  currency            String   @default("cad")
  dueDate             DateTime
  /// PAST_DUE | INVITED | PLAN_ACTIVE | SETTLED | WRITTEN_OFF
  status              String   @default("PAST_DUE")
  /// 1-30 | 31-60 | 61-90 | 90+
  agingBucket         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  paymentPlans        PaymentPlan[]

  @@unique([businessId, externalRef])
  @@index([businessId, status])
  @@index([customerId])
  @@index([agingBucket])
}

/// Installment plan chosen by the consumer (6 / 12 / 18 months).
model PaymentPlan {
  id                      String   @id @default(cuid())
  customerId              String
  customer                Customer @relation(fields: [customerId], references: [id])
  invoiceId               String
  invoice                 Invoice  @relation(fields: [invoiceId], references: [id])

  /// 6 | 12 | 18
  termMonths              Int
  /// Term at signup before skip extensions.
  originalTermMonths      Int
  monthlyAmountCents      Int
  totalAmountCents        Int
  currency                String   @default("cad")

  /// PENDING_MANDATE | ACTIVE | COMPLETED | DEFAULTED | CANCELLED
  status                  String   @default("PENDING_MANDATE")
  startDate               DateTime?
  extendedByMonths        Int      @default(0)
  lastSkipAt              DateTime?
  nextSkipAvailableAt     DateTime?

  /// Stripe objects created on the *connected* account (Direct Charge model).
  stripeCustomerId        String?
  stripePaymentMethodId   String?
  /// ACSS mandate id once bank authorization is complete.
  stripeMandateId         String?

  padMandateAcceptedAt    DateTime?
  /// Rule H1: written confirmation must be sent before first debit.
  padWrittenConfirmSentAt DateTime?

  /// Settlement-terms dispute freeze — halt automated presentment until cleared.
  disputeFrozenAt         DateTime?
  disputeReason           String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  installments            Installment[]
  skipRequests            SkipRequest[]
  padMandate              PadMandate?

  @@index([status])
  @@index([customerId])
  @@index([invoiceId])
  @@index([stripeCustomerId])
  @@index([disputeFrozenAt])
}

/// Payments Canada Rule H1 Personal PAD electronic mandate + audit trail.
model PadMandate {
  id                 String      @id @default(cuid())
  paymentPlanId      String      @unique
  paymentPlan        PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  /// PERSONAL_PAD (consumer) — Pymtx does not use Business PADs for B2C.
  mandateType        String      @default("PERSONAL_PAD")
  payorName          String
  payorEmail         String
  bankLast4          String?
  institutionName    String?
  /// Stripe mandate / payment method snapshot.
  stripeMandateId    String?
  acceptedAt         DateTime
  ipAddress          String?
  userAgent          String?
  confirmationSentAt DateTime?
  /// Frozen copy of mandatory H1 disclosure text at acceptance time.
  cancellationTerms  String
  recourseTerms      String
  /// Document 2 / 3 version stamps for audit retention (Rule H1 ≥ 12 months).
  agreementVersion   String?
  settlementTermsVersion String?
  /// Full rendered PAD agreement text frozen at acceptance.
  agreementText      String?   @db.Text
  settlementTermsText String?  @db.Text
  /// Payor cancelled PAD authorization in portal (does not extinguish debt).
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime    @default(now())
}

/// One scheduled (or skipped/failed) monthly debit.
model Installment {
  id                    String      @id @default(cuid())
  paymentPlanId         String
  paymentPlan           PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  sequence              Int
  dueDate               DateTime
  /// Preserved when dueDate moves (skips) or for NSF 30-day window from first presentment.
  originalDueDate       DateTime
  amountCents           Int
  /// SCHEDULED | SKIPPED | QUEUED | PROCESSING | SUCCEEDED | FAILED_NSF | FAILED | CANCELLED
  status                String      @default("SCHEDULED")

  stripePaymentIntentId String?
  /// Idempotency key for Stripe PaymentIntent create (Inngest-safe retries).
  idempotencyKey        String?     @unique

  attemptCount          Int         @default(0)
  lastAttemptAt         DateTime?
  /// Rule H1: only one NSF re-try allowed within the window.
  nsfRetryUsed          Boolean     @default(false)
  /// Timestamp of the *original* presentment used as NSF window anchor.
  originalPresentmentAt DateTime?
  failureCode           String?
  failureMessage        String?

  paidAt                DateTime?
  applicationFeeCents   Int         @default(0)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  skipRequest           SkipRequest?
  debitAttempts         DebitAttempt[]

  @@unique([paymentPlanId, sequence])
  /// Primary lookup for Inngest daily recurring job.
  @@index([status, dueDate])
  @@index([paymentPlanId, status])
}

/// Consumer skip privilege: 1 every 180 days, ≥3 business days notice.
model SkipRequest {
  id               String      @id @default(cuid())
  paymentPlanId    String
  paymentPlan      PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  installmentId    String      @unique
  installment      Installment @relation(fields: [installmentId], references: [id])
  requestedAt      DateTime    @default(now())
  /// APPROVED | REJECTED | PENDING
  status           String      @default("APPROVED")
  rejectionReason  String?
  /// Sequence number of the installment appended at end of schedule.
  appendedSequence Int?
  businessDaysNotice Int?

  @@index([paymentPlanId, requestedAt])
}

/// Per-attempt ledger for Direct Charges (supports NSF retry auditing).
model DebitAttempt {
  id                    String      @id @default(cuid())
  installmentId         String
  installment           Installment @relation(fields: [installmentId], references: [id])
  attemptNumber         Int
  /// PRESENTMENT | NSF_RETRY
  kind                  String      @default("PRESENTMENT")
  /// PENDING | SUCCEEDED | FAILED_NSF | FAILED
  status                String      @default("PENDING")
  stripePaymentIntentId String?
  applicationFeeCents   Int         @default(0)
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime    @default(now())
  completedAt           DateTime?

  @@index([installmentId, attemptNumber])
  @@index([stripePaymentIntentId])
}

/// Inngest (or cron) daily debit runner audit row.
model DebitJobRun {
  id              String    @id @default(cuid())
  /// Calendar date the job targeted (UTC date string YYYY-MM-DD).
  runDate         String
  /// RUNNING | SUCCEEDED | FAILED | PARTIAL
  status          String    @default("RUNNING")
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  scannedCount    Int       @default(0)
  queuedCount     Int       @default(0)
  succeededCount  Int       @default(0)
  failedCount     Int       @default(0)
  skippedCount    Int       @default(0)
  errorSummary    String?

  @@unique([runDate])
  @@index([startedAt])
}


/// Portal login — ADMIN platform ops, or OWNER/CLERK staff scoped to one creditor.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  /// ADMIN | OWNER | CLERK  (legacy BUSINESS treated as OWNER)
  role         String
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id])
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([businessId])
}

/// One-time staff password-reset tokens (email link).
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Opaque session tokens (httpOnly cookie pymtx_session).
/// Exactly one of userId / customerId is set.
model Session {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([expiresAt])
}

/// One-time customer magic-link tokens (email login without password).
model MagicLink {
  id         String    @id @default(cuid())
  token      String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([email, createdAt])
  @@index([expiresAt])
}

/// CASL white-labeled outbound message log (from = business trade name).
model CaslMessage {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  /// INVITE | PAD_CONFIRMATION | RECEIPT | SKIP_CONFIRMATION | MAGIC_LINK | NSF_ALERT
  kind         String
  fromName     String
  toEmail      String
  subject      String
  bodyPreview  String?
  sentAt       DateTime  @default(now())
  providerId   String?

  deferredNotice DeferredNotice?

  @@index([businessId, sentAt])
  @@index([customerId])
  @@index([customerId, sentAt])
}

/// Queued debtor notices waiting for Ontario CDSSA contact hours.
model DeferredNotice {
  id            String   @id @default(cuid())
  caslMessageId String   @unique
  caslMessage   CaslMessage @relation(fields: [caslMessageId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  fromName      String
  toEmail       String
  subject       String
  html          String   @db.Text
  text          String   @db.Text
  /// Optional PDF attachments as JSON [{filename,content,contentType}]
  attachmentsJson String? @db.Text
  sendAfter     DateTime
  sentAt        DateTime?
  /// Suppressed while communication pause / cadence permanently cancels the send.
  suppressedAt  DateTime?
  suppressReason String?
  attempts      Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())

  @@index([sendAfter, sentAt])
  @@index([businessId])
}

/// Platform take-rate metrics (application fees only — never principal custody).
model TransactionMetric {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id])
  /// Unique when set — prevents double-count on webhook retries.
  installmentId       String?  @unique
  principalCents      Int
  applicationFeeCents Int
  feeBps              Int
  occurredAt          DateTime @default(now())

  @@index([businessId, occurredAt])
  @@index([occurredAt])
}

/// Stripe webhook delivery idempotency (event.id is globally unique).
model StripeWebhookEvent {
  id          String   @id @default(cuid())
  /// Stripe event id (evt_...).
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
  summary     String?

  @@index([type, processedAt])
}
