DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pymtx?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/pymtx?sslmode=require"
STRIPE_SECRET_KEY="sk_test_placeholder"
# Aliases also accepted: PYMTX_STRIPE_SECRET_KEY, PYMTX_STRIPE_MCP_KEY
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
# Optional Connect endpoint secret (preferred when set); falls back to STRIPE_WEBHOOK_SECRET
STRIPE_CONNECT_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
# Aliases: NEXT_PUBLIC_PYMTX_STRIPE_PUBLISHABLE_KEY, PYMTX_STRIPE_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_FEE_BPS="250"
# Optional — required for production Inngest (dev CLI works without these)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Optional — Redis for distributed rate limits (falls back to in-memory)
REDIS_URL=""
# Email: demo (default) returns magic-link demoUrl; resend sends real mail
EMAIL_PROVIDER="demo"
RESEND_API_KEY=""
EMAIL_FROM="noreply@pymtx.com"
# Geoapify Address Autocomplete (Canada / Ontario-biased). Server-side only.
# https://myprojects.geoapify.com/ — keep off NEXT_PUBLIC_*
GEOAPIFY_API_KEY=""
# Demo auth (seeded):
# admin@pymtx.example / pymtx-admin-demo
# billing@mapleridgedental.example / pymtx-business-demo (OWNER)
# clerk@mapleridgedental.example / pymtx-clerk-demo (CLERK)
# Customer magic link: aisha.rahman@example.com → /login/customer
# Production: leave unset or false. Local/non-production already allows demo via NODE_ENV.
# Set true only for staged demos without live Stripe.
ALLOW_DEMO_MODE="false"
# When true under go-live lock, money rails require sk_live_ / pk_live_ (real CAD PADs).
REQUIRE_LIVE_STRIPE="false"
# Job script / ops: daily debit + charges require an admin session cookie.
